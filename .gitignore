# Данные соревнования: 574 МБ, один файл 425 МБ — в git не помещаются.
# Кладутся локально в data/ либо подключаются датасетом на Kaggle.
data/

# Окружение
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Результаты прогонов: сабмиты, отчёты, веса моделей по 35 МБ.
# Веса воспроизводятся обучением, а для сверки хватает artifacts/pred_*.npy
notebook_output/

# Веса и модели: 71 МБ на ветку byte2byte, вывод стадий end2end.
# Структура папок в git есть, содержимое — нет.
models/**/*.txt
models/**/*.cbm
models/**/*.pt
models/**/*.joblib

# Рабочие материалы, не относящиеся к решению: исходные ноутбуки,
# исторический пакет best_solution/, кэши прототипирования
_local/
_cache/

# Тексты: в репозиторий идут README рядом с кодом, черновики — нет
*.md
!README.md
!notebooks/README.md
!models/byte2byte/README.md
!models/end2end/README.md

# Ноутбуки: в репозиторий идут только два готовых из notebooks/,
# рабочие копии и черновики в корне — нет
*.ipynb
!notebooks/antifraud_solution.ipynb
!notebooks/e2e_solution.ipynb

# Архив весов финального слоя (7.4 МБ) — распакован в _local/
Weights.tar.gz
